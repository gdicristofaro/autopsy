<project name="org.sleuthkit.autopsy.corelibs" default="netbeans" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant">
    <description>Builds, tests, and runs the project org.sleuthkit.autopsy.corelibs.</description>
    <import file="nbproject/build-impl.xml"/>
    <import file="../BootstrapIvy.xml"/>
    
    
    <!-- will assume root if ran from root build.xml or take this rel path -->
    <property name="project.basedir" value="${basedir}/../" />
    <import file="${project.basedir}/thirdparty/build-thirdparty.xml"/>
    
    <property name="modules.dir" value="${basedir}/release/modules/" />
    <property name="ext.dir" value="${modules.dir}/ext" />
    <property name="lib.dir" value="${modules.dir}/lib" />
     
    <target name="get-thirdparty-dependencies" description="get third-party dependencies"> 
        <antcall target="copy-thirdparty-folders" inheritAll="true">
            <param name="thirdparty.folders" value="opencv,libheif" />
            <param name="thirdparty.target-dir" value="${basedir}/release"/>
            <param name="thirdparty.target-ext-dir" value="${ext.dir}"/>
            <param name="thirdparty.target-lib-dir" value="${lib.dir}"/>
        </antcall>
    </target>
    
    <target name="get-deps" description="retrieve dependencies using ivy" depends="init-ivy,get-thirdparty-dependencies">
        <ivy:settings file="ivysettings.xml" />
        <ivy:resolve log="quiet"/>
        
        <!-- Make a report that lists out the dependencies that our JARs have -->	
        <ivy:report todir='${basedir}/build/ivy-reports' graph='true' xml='false'/>
        <ivy:retrieve pattern="${basedir}/release/modules/ext/[artifact]-[revision](-[classifier]).[ext]" />
    </target>
    
    <target name="init" depends="get-deps,harness.init"/>

    <target name="clean" depends="projectized-common.clean">
        <!--Override clean to delete jars, etc downloaded with Ivy, 
        or copied in from thirdparty folder.  This way we don't end up with 
        out-of-date/unneeded stuff in the installer-->
        <delete dir="${basedir}/release"/>
    </target>
</project>
