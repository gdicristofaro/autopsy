<project name="org.sleuthkit.autopsy.modules.leappanalyzers" default="netbeans" basedir=".">
    <description>Builds, tests, and runs the project org.sleuthkit.autopsy.modules.leappanalyzers.</description>
    <import file="nbproject/build-impl.xml"/>

    <target name="build" depends="suite.build">
        <property name="thirdparty.dir" value="${suite.dir}/../thirdparty" />

        <!--Copy iLeapp to release-->
        <copy todir="${suite.dir}/release/iLeapp" >
            <fileset dir="${thirdparty.dir}/iLeapp"/>
        </copy>
		
        <!--Copy aLeapp to release-->
        <copy todir="${suite.dir}/release/aLeapp" >
            <fileset dir="${thirdparty.dir}/aLeapp"/>
        </copy>
    </target>
</project>
