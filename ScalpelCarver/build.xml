<project name="org.sleuthkit.autopsy.scalpel" default="netbeans" basedir=".">
    <description>Builds, tests, and runs the project org.sleuthkit.autopsy.scalpel.</description>
    <import file="nbproject/build-impl.xml"/>
    
    <property name="project.basedir" value="${basedir}/../" />
    <import file="${project.basedir}/thirdparty/build-thirdparty.xml"/>

    <property name="modules.dir" value="${basedir}/release/modules/" />
    <property name="ext.dir" value="${modules.dir}/ext" />
    <property name="lib.dir" value="${modules.dir}/lib" />
    
     <target name="get-native-libs" description="get native library dependencies"> 
        <antcall target="copy-thirdparty-folders" inheritAll="true">
            <param name="thirdparty.folders" value="libscalpel_jni" />
            <param name="thirdparty.target-dir" value="${project.basedir}/release"/>
            <param name="thirdparty.target-ext-dir" value="${ext.dir}"/>
            <param name="thirdparty.target-lib-dir" value="${lib.dir}"/>
        </antcall>
    </target>
    
    
     <target name="init" depends="basic-init,files-init,build-init,-javac-init,get-native-libs">
        <!-- overrode depends attribute -->
        
    </target>
</project>
